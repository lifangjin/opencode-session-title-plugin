{
  "name": "@lifangjin/opencode-session-title-plugin",
  "version": "0.0.2",
  "description": "Filter irrelevant system-prompt injections from opencode session title generation to save tokens",
  "type": "module",
  "author": "lifangjin <lifangjin@gmail.com> (https://github.com/lifangjin)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifangjin/opencode-session-title-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/lifangjin/opencode-session-title-plugin/issues"
  },
  "homepage": "https://github.com/lifangjin/opencode-session-title-plugin#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "tsc"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "session",
    "title",
    "token-optimization",
    "prompt-filter"
  ],
  "license": "MIT",
  "devDependencies": {
    "@opencode-ai/plugin": "^1.4.6",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.4.0"
  },
  "dependencies": {
    "gpt-tokenizer": "^3.4.0"
  }
}
